# Dependencies
node_modules/

# Build output
dist/
dev-dist/

# TypeScript incremental build caches (machine-specific, unreviewable)
*.tsbuildinfo

# Local env — never commit secrets
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
*.local
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
npm-debug.log*
*.log

# Wrangler's scratch: bundle temp dirs and the local miniflare cache. Written
# on every `wrangler pages dev` / `pages functions build`, so they are pure
# machine state — 22 MB of them were committed by a `git add -A` before this
# line existed.
.wrangler/
